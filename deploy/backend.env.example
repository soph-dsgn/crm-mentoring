# Copy outside the Git checkout, set mode 0600 and replace every placeholder.
KURATORSKAYA_ENVIRONMENT=production
KURATORSKAYA_DEBUG=false
KURATORSKAYA_DATABASE_URL=postgresql+psycopg://CRM_DB_USER:REPLACE_WITH_SECRET@host.docker.internal:5432/CRM_DB_NAME?sslmode=require
KURATORSKAYA_DATABASE_POOL_SIZE=3
KURATORSKAYA_DATABASE_MAX_OVERFLOW=1
KURATORSKAYA_DATABASE_POOL_TIMEOUT_SECONDS=15
KURATORSKAYA_DATABASE_CONNECT_TIMEOUT_SECONDS=5
KURATORSKAYA_PERMITTED_HOSTS=["API_HOSTNAME"]
KURATORSKAYA_FRONTEND_ORIGINS=["https://FRONTEND_HOSTNAME"]
KURATORSKAYA_TRUSTED_PROXY_IPS=[]
KURATORSKAYA_AUTH_PASSWORD_MIN_LENGTH=12
KURATORSKAYA_AUTH_SESSION_IDLE_DAYS=7
KURATORSKAYA_AUTH_SESSION_ABSOLUTE_DAYS=30
KURATORSKAYA_AUTH_LOGIN_WINDOW_MINUTES=15
KURATORSKAYA_AUTH_LOGIN_MAX_FAILURES_PER_LOGIN=5
KURATORSKAYA_AUTH_LOGIN_MAX_FAILURES_PER_CLIENT=20
