    pointA:`${p[4]}; ${p[8].toLowerCase()}.`, pointB:`${p[9]}.`, notes:'', strategyUpdatedAt:now, createdAt:now,
  }))
  const titles: Record<Stage,string[]> = { start:['Описать точку А','Разобрать опыт и навыки','Подготовить резюме'], portfolio:['Собрать структуру кейса','Доработать текст кейса','Провести финальное ревью'], search:['Обновить портфолио для откликов','Подготовить сопроводительное письмо','Провести пробное интервью'] }
  const tasks: StrategyTask[] = students.flatMap((s,i) => titles[s.stage].map((title,j) => ({ id:`demo-task-${i}-${j}`, studentId:s.id, title, description:j===1?'Подготовить материал к следующей встрече и приложить ссылку.':'', stage:s.stage, status:i<4?(j===0?'done':j===1?'progress':'backlog'):i<8?'backlog':'done', owner:j===2&&i%3===0?'Аня':'Софья', dueAt:j===1&&i<4?['2026-10-27','2026-10-30','2026-11-03','2026-11-06'][i]:'', url:'', comments:'', order:j, blocker:j===2&&i===0, createdAt:now, updatedAt:now })))
  const meetings: Meeting[] = [ { id:'demo-meeting-1',studentId:'demo-1',date:'2026-10-10',title:'Разбор первого кейса',summary:'Согласовали структуру и следующий шаг: переписать описание результата.',createdAt:now }, { id:'demo-meeting-2',studentId:'demo-3',date:'2026-10-14',title:'Подготовка к откликам',summary:'Обсудили позиционирование и список целевых вакансий.',createdAt:now } ]
  return {version:2,groups,students,tasks,meetings,demo:true,demoRevision:2}
}

export function normalizeData(value: unknown): AppData {
  if (!value || typeof value !== 'object') throw new Error('Invalid data')
  const raw = value as {version:number;groups:(Partial<Group>&{archived?:boolean})[];students:Partial<Student>[];tasks:StrategyTask[];meetings?:Meeting[];demo?:boolean;demoRevision?:number}
  if (!Array.isArray(raw.groups) || !Array.isArray(raw.students) || !Array.isArray(raw.tasks) || (raw.version !== 1 && raw.version !== 2)) throw new Error('Invalid data')
  if (!raw.groups.every(g => typeof g?.id === 'string' && typeof g?.name === 'string') || !raw.students.every(s => typeof s?.id === 'string' && typeof s?.groupId === 'string') || !raw.tasks.every(t => typeof t?.id === 'string' && typeof t?.studentId === 'string')) throw new Error('Invalid data')
  if (raw.version === 1 && raw.groups.length>0 && raw.students.length>0 && raw.groups.every(g => g.id?.startsWith('demo-')) && raw.students.every(s => s.id?.startsWith('demo-'))) return demoData()
  if (raw.version === 2 && raw.demo && !raw.demoRevision && raw.groups.length>0 && raw.groups.every(g => g.id?.startsWith('demo-')) && raw.students.every(s => s.id?.startsWith('demo-'))) return demoData()
  const groups: Group[] = raw.groups.map(g => ({ id:g.id!, name:g.name!, startsAt:g.startsAt||'', endsAt:g.endsAt||'', actualEndsAt:g.actualEndsAt||'', status:g.status || (g.archived?'archived':'active'), statusBeforeArchive:g.archived?'completed':g.statusBeforeArchive||null, notes:g.notes||'', createdAt:g.createdAt||new Date().toISOString() }))
  const students: Student[] = raw.students.map(s => ({ id:s.id!, groupId:s.groupId!, name:s.name||'', age:s.age??null, photo:s.photo||'', avatarIndex:s.avatarIndex??-1, stage:s.stage||'start', startsAt:s.startsAt||'', level:s.level||'', desiredPosition:s.desiredPosition||'', careerGoal:s.careerGoal||'', links:{figma:s.links?.figma||'',portfolio:s.links?.portfolio||'',resume:s.links?.resume||'',telegram:s.links?.telegram||'',notion:s.links?.notion||''}, background:s.background||'',experience:s.experience||'',strengths:s.strengths||'',growthAreas:s.growthAreas||'',difficulties:s.difficulties||'',expectations:s.expectations||'',personalNotes:s.personalNotes||'',pointA:s.pointA||'',pointB:s.pointB||'',notes:s.notes||'',strategyUpdatedAt:s.strategyUpdatedAt||new Date().toISOString(),createdAt:s.createdAt||new Date().toISOString() }))
  const tasks = raw.tasks.filter(t => typeof t?.id === 'string' && typeof t?.studentId === 'string' && typeof t?.title === 'string')
  const meetings = (Array.isArray(raw.meetings)?raw.meetings:[]).filter(m => typeof m?.id === 'string' && typeof m?.studentId === 'string') as Meeting[]
  return {version:2,groups,students,tasks,meetings,demo:Boolean(raw.demo),demoRevision:raw.demoRevision}
}
export function loadData(): AppData { const raw=localStorage.getItem(STORAGE_KEY); if(!raw)return demoData(); try{return normalizeData(JSON.parse(raw))}catch{try{localStorage.setItem(`${STORAGE_KEY}-recovery-${Date.now()}`,raw)}catch{/* storage unavailable */}return demoData()} }
export function isAppData(value: unknown): value is AppData { try { normalizeData(value); return true } catch { return false } }
</file>

