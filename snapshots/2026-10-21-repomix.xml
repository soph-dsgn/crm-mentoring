import type { ReactNode } from 'react'
import { ArrowUpRight, Plus } from 'lucide-react'
import Avatar from './Avatar'
import { dateLabel, groupProgress, isOverdue, nearestTask, studentTasks } from './data'
import type { AppData, Group, StrategyTask, Student } from './types'

type Attention = { student: Student; overdue: number; blockers: number; stale: boolean }
const plural = (n: number, one: string, few: string, many: string) => `${n} ${n % 10 === 1 && n % 100 !== 11 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? few : many}`

function BoardCard({ title, subtitle, children, onClick, round = false, variant = '' }: {
  title: string; subtitle?: string; children: ReactNode; onClick: () => void; round?: boolean; variant?: string
}) {
  return <button className={`board-card ${variant}`} onClick={onClick}>
    <span className="board-card-heading"><strong>{title}</strong>{subtitle && <small>{subtitle}</small>}</span>
    <span className="board-card-content">{children}</span>
    {round && <span className="board-card-round" aria-hidden="true"><ArrowUpRight size={14}/></span>}
  </button>
}

export default function PlanOverview({ data, activeGroups, tasks, attention, upcoming, onGroup, onStudent, onTask, onNewGroup, onStrategies, onAnya }: {
  data: AppData; activeGroups: Group[]; tasks: StrategyTask[]; attention: Attention[]; upcoming: StrategyTask[];
  onGroup: (id: string) => void; onStudent: (id: string) => void; onTask: (id: string) => void;
  onNewGroup: () => void; onStrategies: () => void; onAnya: () => void
}) {
  const activeIds = new Set(activeGroups.map(g => g.id))
  const students = data.students.filter(s => activeIds.has(s.groupId))
  const work = tasks.filter(t => t.status === 'progress')
  const anya = tasks.filter(t => t.owner === 'Аня' && t.status !== 'done')
  const overdue = tasks.filter(t => t.status !== 'done' && isOverdue(t.dueAt))
  const nextGroup = data.groups.filter(g => g.status === 'backlog').sort((a, b) => a.startsAt.localeCompare(b.startsAt))[0]
  const firstGroup = activeGroups[0]
  const firstStudent = students[0]
  const firstTask = work[0]
  const firstAttention = attention[0]
  const firstUpcoming = upcoming[0]
  const firstAnya = anya[0]
  const groupMembers = firstGroup ? data.students.filter(s => s.groupId === firstGroup.id) : []
  const studentNext = firstStudent && nearestTask(studentTasks(data, firstStudent.id))

  return <div className="workspace-board">
    <div className="board-heading">
      <h1><span>Обзор</span><button onClick={onStrategies}>Группы</button><button onClick={onAnya}>Проверки</button></h1>
      <div className="board-tabs"><span className="current">Сегодня</span><button onClick={onStrategies}>Стратегии</button><button onClick={onAnya}>Задачи Ани</button></div>
    </div>
    <div className="board-grid">
      <BoardCard title="Активные группы" subtitle="Потоки в работе" onClick={firstGroup ? () => onGroup(firstGroup.id) : onNewGroup} round>
        <strong>{firstGroup?.name || 'Создать группу'}</strong>
        <span>{firstGroup ? `${plural(groupMembers.length, 'ученица', 'ученицы', 'учениц')} · ${groupProgress(data, firstGroup)}% плана` : 'Начните с первого потока'}</span>
      </BoardCard>
      <BoardCard title="Ученицы" subtitle="Индивидуальные маршруты" onClick={firstStudent ? () => onStudent(firstStudent.id) : onStrategies} variant="board-card-people">
        {students.length ? <><span className="board-portraits">{students.slice(0, 4).map(s => <Avatar key={s.id} student={s} size="sm"/>)}</span><span>{plural(students.length, 'ученица', 'ученицы', 'учениц')} в активных группах{studentNext ? ` · далее ${studentNext.title}` : ''}</span></> : <span>Пока никого нет</span>}
      </BoardCard>
      <BoardCard title="В работе" subtitle={work.length ? `${plural(work.length, 'задача', 'задачи', 'задач')} в плане` : 'Текущие задачи'} onClick={firstTask ? () => onTask(firstTask.id) : onStrategies} round>
        <strong>{firstTask?.title || 'Откройте стратегию'}</strong>
        {firstTask && <span>{data.students.find(s => s.id === firstTask.studentId)?.name}</span>}
      </BoardCard>
      <BoardCard title="Требуют внимания" subtitle={overdue.length ? 'Есть просроченные задачи' : 'Текущий фокус'} onClick={firstAttention ? () => onStudent(firstAttention.student.id) : onStrategies} variant="board-card-attention">
        <strong>{firstAttention?.student.name || 'Всё спокойно'}</strong>
        {firstAttention && <span>{firstAttention.overdue ? 'Просрочена задача' : firstAttention.blockers ? 'Есть блокирующая задача' : 'Пора обновить стратегию'}</span>}
      </BoardCard>
      <BoardCard title="Ближайшее" subtitle={firstUpcoming ? dateLabel(firstUpcoming.dueAt) : nextGroup ? `Старт ${dateLabel(nextGroup.startsAt)}` : 'Пока нет сроков'} onClick={firstUpcoming ? () => onTask(firstUpcoming.id) : nextGroup ? () => onGroup(nextGroup.id) : onStrategies}>
        <strong>{firstUpcoming?.title || nextGroup?.name || 'Добавьте срок к задаче'}</strong>
        {firstUpcoming && <span>{data.students.find(s => s.id === firstUpcoming.studentId)?.name}</span>}
      </BoardCard>
      <BoardCard title="Задачи Ани" subtitle="На согласовании" onClick={onAnya} round variant="board-card-anya">
        <strong>{firstAnya?.title || 'Очередь пуста'}</strong>
        <span>{anya.length ? `${anya.length} ожидают участия` : 'Можно вернуться к стратегии'}</span>
      </BoardCard>
    </div>
    <div className="board-footer"><button onClick={onNewGroup}>Новая группа <Plus size={14}/></button></div>
  </div>
}
</file>

<file path="src/ProfilePage.tsx">
import { useEffect, useState } from 'react'
import { ArrowDown, ArrowLeft, ArrowRight, ArrowUp, CalendarDays, Check, ChevronDown, ClipboardList, ExternalLink, GripVertical, List, MoreHorizontal, Plus, Trash2 } from 'lucide-react'
import Avatar from './Avatar'
import { dateLabel, isOverdue, nearestTask, progress, STATUS, STAGES, today, uid } from './data'
import type { AppData, Meeting, Stage, StrategyTask, Student, TaskStatus } from './types'

type Tab = 'overview'|'strategy'|'homework'|'meetings'|'notes'
const tabs: {id:Tab;label:string}[] = [{id:'overview',label:'Обзор'},{id:'strategy',label:'Стратегия'},{id:'homework',label:'Домашние задания'},{id:'meetings',label:'История встреч'},{id:'notes',label:'Заметки'}]

export default function ProfilePage({ data, student, tasks, view, setView, stageFilter, setStageFilter, onBack, onEdit, onDelete, onNewTask, onEditTask, onStatus, onMove, onPatch, onAddMeeting, onDeleteMeeting }: {
  data:AppData; student:Student; tasks:StrategyTask[]; view:'board'|'list'; setView:(v:'board'|'list')=>void; stageFilter:Stage|'all'; setStageFilter:(v:Stage|'all')=>void;
  onBack:()=>void; onEdit:()=>void; onDelete:()=>void; onNewTask:()=>void; onEditTask:(t:StrategyTask)=>void; onStatus:(id:string,status:TaskStatus)=>void; onMove:(t:StrategyTask,delta:number)=>void;
  onPatch:(patch:Partial<Student>)=>void; onAddMeeting:(meeting:Meeting)=>void; onDeleteMeeting:(id:string)=>void
}) {
  const [tab,setTab] = useState<Tab>('overview')
  const [selected,setSelected] = useState<string[]>([])
  const [notesDraft,setNotesDraft] = useState(student.notes)
  const [meetingDraft,setMeetingDraft] = useState<Meeting|null>(null)
  useEffect(() => { setTab('overview'); setSelected([]) }, [student.id])
  useEffect(() => setNotesDraft(student.notes), [student.notes, student.id])
  const group = data.groups.find(g => g.id === student.groupId)
  const filtered = tasks.filter(t => stageFilter==='all'||t.stage===stageFilter).sort((a,b)=>a.order-b.order)
  const meetings = data.meetings.filter(m=>m.studentId===student.id).sort((a,b)=>b.date.localeCompare(a.date))
  const next = nearestTask(tasks)
  const toggle = (id:string) => setSelected(ids=>ids.includes(id)?ids.filter(x=>x!==id):[...ids,id])
  const bulk = (status:TaskStatus) => { selected.forEach(id=>onStatus(id,status)); setSelected([]) }
  const about = [
    ['Бэкграунд',student.background],['Опыт и проекты',student.experience],['Сильные стороны',student.strengths],
    ['Зоны роста',student.growthAreas],['Текущие сложности',student.difficulties],['Карьерные ожидания',student.expectations],['Особенности и заметки',student.personalNotes],
  ]
  return <>
    <button className="back-link" onClick={onBack}><ArrowLeft size={16}/>{group?.name||'Группа'}</button>
    <div className="profile-header"><div className="profile-identity"><Avatar student={student} size="xl"/><div><div className="eyebrow">Персональный профиль</div><h1>{student.name}<span className="lime-dot">.</span></h1><p>{group?.name} · {student.desiredPosition||student.careerGoal||'Позиция не указана'}</p></div></div><div className="heading-actions"><button className="btn secondary" onClick={onEdit}>Редактировать профиль</button><button className="btn dark" onClick={onNewTask}><Plus size={17}/> Новая задача</button></div></div>
    <div className="profile-tabs" role="tablist" aria-label="Разделы профиля">{tabs.map(t=><button key={t.id} role="tab" aria-selected={tab===t.id} className={tab===t.id?'selected':''} onClick={()=>setTab(t.id)}>{t.label}{t.id==='strategy'&&<span>{tasks.length}</span>}{t.id==='meetings'&&<span>{meetings.length}</span>}</button>)}</div>
    {tab==='overview'&&<>
      <div className="profile-top-grid"><section className="profile-focus"><div className="eyebrow">Сейчас в фокусе</div><div className="profile-focus-main"><div><h2>{STAGES.find(s=>s.id===student.stage)?.number}. {STAGES.find(s=>s.id===student.stage)?.label}</h2><p>{next?next.title:'Ближайшая задача пока не назначена'}</p>{next?.dueAt&&<span className={isOverdue(next.dueAt)?'text-red':''}><CalendarDays size={14}/> До {dateLabel(next.dueAt)}</span>}</div><div className="profile-big-progress">{progress(tasks)}<small>%</small></div></div><div className="profile-track"><span style={{width:`${progress(tasks)}%`}}/></div><button onClick={()=>setTab('strategy')}>Открыть стратегию <ArrowRight size={16}/></button></section><section className="profile-facts"><div className="eyebrow">Основное</div><div className="fact-grid"><div><small>Возраст</small><strong>{student.age?`${student.age} ${student.age%10===1&&student.age%100!==11?'год':student.age%10>=2&&student.age%10<=4&&(student.age%100<12||student.age%100>14)?'года':'лет'}`:'Не указан'}</strong></div><div><small>Начало обучения</small><strong>{dateLabel(student.startsAt)}</strong></div><div><small>Уровень</small><strong>{student.level||'Не указан'}</strong></div><div><small>Желаемая позиция</small><strong>{student.desiredPosition||'Не указана'}</strong></div></div><div className="career-goal"><small>Карьерная цель</small><p>{student.careerGoal||'Добавьте карьерную цель в профиль'}</p></div></section></div>
      <div className="profile-content-grid"><section className="surface about-card"><div className="section-head"><div><div className="eyebrow">Контекст</div><h2>Об ученице</h2></div><button className="text-link" onClick={onEdit}>Редактировать <ArrowRight size={16}/></button></div><div className="about-grid">{about.map(([label,value])=><div key={label}><small>{label}</small><p>{value||'Не заполнено'}</p></div>)}</div></section><div className="profile-side-stack"><section className="surface point-card"><div className="eyebrow">Путь и результат</div><div><small>Точка А</small><p>{student.pointA||'Пока не заполнена'}</p></div><ArrowDown size={18}/><div><small>Точка Б</small><p>{student.pointB||'Пока не заполнена'}</p></div></section><section className="surface links-card"><div className="eyebrow">Материалы и связь</div>{Object.entries(student.links).filter(([,url])=>url).length?Object.entries(student.links).filter(([,url])=>url).map(([key,url])=><a key={key} href={url} target="_blank" rel="noreferrer"><span>{key==='resume'?'Резюме':key==='portfolio'?'Портфолио':key==='telegram'?'Telegram':key==='notion'?'Notion':'Figma'}</span><ExternalLink size={15}/></a>):<p>Ссылки пока не добавлены.</p>}</section></div></div>
      <button className="delete-student" onClick={onDelete}><Trash2 size={15}/> Удалить ученицу и её данные</button>
    </>}
    {tab==='strategy'&&<>
      <div className="strategy-summary"><div><span>Общий прогресс</span><strong>{progress(tasks)}%</strong></div><div><span>В работе</span><strong>{tasks.filter(t=>t.status==='progress').length}</strong></div><div><span>Готово</span><strong>{tasks.filter(t=>t.status==='done').length}</strong></div><div><span>Просрочено</span><strong>{tasks.filter(t=>t.status!=='done'&&isOverdue(t.dueAt)).length}</strong></div></div>
      <div className="stage-progress">{STAGES.map(st=>{const stTasks=tasks.filter(t=>t.stage===st.id);return <div key={st.id}><div className="stage-progress-top"><span>{st.number} / {st.label}</span><strong>{progress(stTasks)}%</strong></div><div className="progress-track"><div style={{width:`${progress(stTasks)}%`}}/></div></div>})}</div>
      <div className="strategy-toolbar"><div><div className="eyebrow">Задачи и этапы</div><h2>Стратегия <span>{tasks.length}</span></h2></div><div className="toolbar-right"><div className="select-wrap"><select aria-label="Фильтр этапа" value={stageFilter} onChange={e=>setStageFilter(e.target.value as Stage|'all')}><option value="all">Все этапы</option>{STAGES.map(s=><option value={s.id} key={s.id}>{s.number}. {s.label}</option>)}</select><ChevronDown size={16}/></div><div className="view-switch"><button title="Канбан" aria-label="Канбан" className={view==='board'?'selected':''} onClick={()=>setView('board')}><GripVertical size={17}/></button><button title="Список" aria-label="Список" className={view==='list'?'selected':''} onClick={()=>setView('list')}><List size={17}/></button></div></div></div>
      {selected.length>0&&<div className="bulk-bar"><strong>Выбрано: {selected.length}</strong><button onClick={()=>bulk('backlog')}>В бэклог</button><button onClick={()=>bulk('progress')}>В работу</button><button onClick={()=>bulk('done')}>Готово</button><button onClick={()=>setSelected([])}>Сбросить</button></div>}
      {!tasks.length?<div className="profile-empty"><strong>Стратегия пока пуста</strong><p>Добавьте первую задачу, чтобы составить план.</p><button className="btn primary" onClick={onNewTask}><Plus size={16}/> Добавить задачу</button></div>:view==='board'?<div className="kanban">{(Object.keys(STATUS) as TaskStatus[]).map(status=><div className="kanban-column" key={status} onDragOver={e=>e.preventDefault()} onDrop={e=>{e.preventDefault();const id=e.dataTransfer.getData('task-id');if(tasks.some(t=>t.id===id))onStatus(id,status)}}><div className="column-head"><div><span className={`status-dot ${status}`}/><strong>{STATUS[status]}</strong><span className="column-count">{filtered.filter(t=>t.status===status).length}</span></div>{status==='backlog'&&<button className="icon-btn" title="Новая задача" onClick={onNewTask}><Plus size={18}/></button>}</div><div className="column-body">{filtered.filter(t=>t.status===status).map(t=><TaskCard key={t.id} task={t} selected={selected.includes(t.id)} onSelect={()=>toggle(t.id)} onEdit={()=>onEditTask(t)} onMove={onMove} onStatus={onStatus}/>)}{!filtered.some(t=>t.status===status)&&<div className="column-empty">Перетащите задачу сюда</div>}</div></div>)}</div>:<div className="task-list">{(Object.keys(STATUS) as TaskStatus[]).map(status=><div key={status}><div className="list-group-head"><span className={`status-dot ${status}`}/>{STATUS[status]} <span>{filtered.filter(t=>t.status===status).length}</span></div>{filtered.filter(t=>t.status===status).map(t=><div className="task-list-row" key={t.id}><input type="checkbox" checked={selected.includes(t.id)} onChange={()=>toggle(t.id)} aria-label={`Выбрать ${t.title}`}/><button className="task-list-title" onClick={()=>onEditTask(t)}><strong>{t.title}</strong><small>{STAGES.find(s=>s.id===t.stage)?.label} · {t.owner}</small></button><span className={isOverdue(t.dueAt)&&t.status!=='done'?'text-red':''}>{t.dueAt?dateLabel(t.dueAt):'—'}</span><select aria-label={`Статус ${t.title}`} value={t.status} onChange={e=>onStatus(t.id,e.target.value as TaskStatus)}>{Object.entries(STATUS).map(([key,label])=><option value={key} key={key}>{label}</option>)}</select></div>)}</div>)}</div>}
    </>}
    {tab==='homework'&&<div className="profile-empty"><ClipboardList size={27}/><strong>Домашних заданий пока нет</strong><p>В следующей итерации выбранные задачи стратегии будут собираться в домашнее задание с сохранением исходной версии.</p><button className="btn secondary" onClick={()=>setTab('strategy')}>Открыть стратегию</button></div>}
    {tab==='meetings'&&<section className="surface profile-tab-surface"><div className="section-head"><div><div className="eyebrow">Контакт и прогресс</div><h2>История встреч</h2></div><button className="btn dark" onClick={()=>setMeetingDraft({id:uid(),studentId:student.id,date:today(),title:'',summary:'',createdAt:new Date().toISOString()})}><Plus size={16}/> Добавить встречу</button></div>{meetings.length?<div className="meeting-list">{meetings.map(m=><article key={m.id}><div className="meeting-date">{dateLabel(m.date)}</div><div><h3>{m.title}</h3><p>{m.summary||'Без заметок'}</p></div><button title="Удалить встречу" onClick={()=>{if(confirm(`Удалить встречу «${m.title}»?`))onDeleteMeeting(m.id)}}><Trash2 size={16}/></button></article>)}</div>:<div className="profile-empty"><strong>Встреч пока нет</strong><p>Зафиксируйте первую встречу и ключевые договорённости.</p></div>}</section>}
    {tab==='notes'&&<section className="surface profile-tab-surface"><div className="eyebrow">ЛИЧНЫЕ Заметки куратора</div><h2>Заметки</h2><p className="notes-hint">Здесь можно хранить рабочие наблюдения, не привязанные к отдельной встрече.</p><textarea className="notes-editor" rows={12} value={notesDraft} onChange={e=>setNotesDraft(e.target.value)} placeholder="Наблюдения, важные детали, идеи для следующей встречи…"/><div className="notes-actions"><button className="btn primary" disabled={notesDraft===student.notes} onClick={()=>onPatch({notes:notesDraft})}>Сохранить заметки</button></div></section>}
    {meetingDraft&&<div className="modal-backdrop" onMouseDown={e=>{if(e.target===e.currentTarget)setMeetingDraft(null)}}><div className="dialog" role="dialog" aria-modal="true" aria-label="Новая встреча"><div className="dialog-head"><h2>Новая встреча</h2><button className="icon-btn" onClick={()=>setMeetingDraft(null)}>×</button></div><form className="form" onSubmit={e=>{e.preventDefault();if(meetingDraft.title.trim()){onAddMeeting(meetingDraft);setMeetingDraft(null)}}}><label className="field"><span>Дата</span><input type="date" value={meetingDraft.date} onChange={e=>setMeetingDraft({...meetingDraft,date:e.target.value})}/></label><label className="field"><span>Тема встречи</span><input required autoFocus value={meetingDraft.title} onChange={e=>setMeetingDraft({...meetingDraft,title:e.target.value})} placeholder="Например, разбор портфолио"/></label><label className="field"><span>Итоги и договорённости</span><textarea rows={5} value={meetingDraft.summary} onChange={e=>setMeetingDraft({...meetingDraft,summary:e.target.value})}/></label><div className="dialog-actions"><button type="button" className="btn secondary" onClick={()=>setMeetingDraft(null)}>Отмена</button><button className="btn primary">Сохранить встречу</button></div></form></div></div>}
  </>
}

function TaskCard({task,selected,onSelect,onEdit,onMove,onStatus}:{task:StrategyTask;selected:boolean;onSelect:()=>void;onEdit:()=>void;onMove:(t:StrategyTask,d:number)=>void;onStatus:(id:string,s:TaskStatus)=>void}) {
  return <article className={`task-card ${selected?'is-selected':''}`} draggable onDragStart={e=>{e.dataTransfer.setData('task-id',task.id);e.dataTransfer.effectAllowed='move'}}><div className="task-card-top"><input type="checkbox" checked={selected} onChange={onSelect} aria-label={`Выбрать ${task.title}`}/><span className="task-stage">{STAGES.find(s=>s.id===task.stage)?.number} / {STAGES.find(s=>s.id===task.stage)?.label}</span><button className="task-edit" aria-label={`Редактировать ${task.title}`} onClick={onEdit}><MoreHorizontal size={18}/></button></div><button className="task-main" onClick={onEdit}><strong>{task.title}</strong>{task.description&&<p>{task.description}</p>}</button><div className="task-tags">{task.owner==='Аня'&&<span className="pill owner">Аня</span>}{task.blocker&&<span className="pill blocker">Блокирует</span>}</div><div className="task-card-foot"><span className={isOverdue(task.dueAt)&&task.status!=='done'?'text-red':''}><CalendarDays size={14}/>{task.dueAt?dateLabel(task.dueAt):'Без срока'}</span><div><button title="Выше" aria-label="Выше" onClick={()=>onMove(task,-1)}><ArrowUp size={15}/></button><button title="Ниже" aria-label="Ниже" onClick={()=>onMove(task,1)}><ArrowDown size={15}/></button>{task.status!=='done'&&<button className="complete-btn" title="Отметить готовой" aria-label="Отметить готовой" onClick={()=>onStatus(task.id,'done')}><Check size={15}/></button>}</div></div></article>
}
</file>

