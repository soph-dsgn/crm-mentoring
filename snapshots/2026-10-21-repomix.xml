import { lazy, Suspense, useEffect, useMemo, useRef, useState } from 'react'
import { ArrowRight, BookOpen, ChevronDown, ClipboardList, Download, FileText, LayoutDashboard, Search, Settings2, Sparkles, Trash2, Upload, Users, X } from 'lucide-react'
import PlanOverview from './PlanOverview'
import { GroupsPage, GroupDetailPage } from './GroupViews'
import ProfilePage from './ProfilePage'
import { GroupForm, StudentForm } from './Forms'
import { dateLabel, isAppData, isOverdue, loadData, normalizeData, STATUS, STAGES, STORAGE_KEY, studentTasks, today, uid } from './data'
import type { AppData, Group, GroupStatus, Meeting, Stage, StrategyTask, Student, TaskStatus } from './types'

type Page = 'overview' | 'strategies' | 'homework' | 'anya' | 'prompts' | 'textbook'
const KnowledgePage = lazy(() => import('./KnowledgePage'))
type Modal = 'group' | 'student' | 'task' | 'backup' | null
const nav: { id: Page; label: string; icon: typeof LayoutDashboard }[] = [
  { id: 'overview', label: 'Обзор', icon: LayoutDashboard }, { id: 'strategies', label: 'Стратегии', icon: Users },
  { id: 'homework', label: 'Домашние задания', icon: ClipboardList }, { id: 'anya', label: 'Задачи Ани', icon: Sparkles },
  { id: 'prompts', label: 'Промпты', icon: FileText }, { id: 'textbook', label: 'Учебник', icon: BookOpen },
]
const blankLinks = { figma: '', portfolio: '', resume: '', telegram: '', notion: '' }
const newGroup = (): Group => ({ id: uid(), name: '', startsAt: today(), endsAt: '', actualEndsAt: '', status: 'backlog', statusBeforeArchive: null, notes: '', createdAt: new Date().toISOString() })
const newStudent = (groupId: string): Student => ({ id: uid(), groupId, name: '', age: null, photo: '', avatarIndex: -1, stage: 'start', startsAt: today(), level: '', desiredPosition: '', careerGoal: '', links: { ...blankLinks }, background: '', experience: '', strengths: '', growthAreas: '', difficulties: '', expectations: '', personalNotes: '', pointA: '', pointB: '', notes: '', strategyUpdatedAt: new Date().toISOString(), createdAt: new Date().toISOString() })
const newTask = (studentId: string, order: number, stage: Stage): StrategyTask => ({ id: uid(), studentId, title: '', description: '', stage, status: 'backlog', owner: 'Софья', dueAt: '', url: '', comments: '', order, blocker: false, createdAt: new Date().toISOString(), updatedAt: new Date().toISOString() })

function App() {
  const [data, setData] = useState<AppData>(loadData)
  const [page, setPage] = useState<Page>('overview')
  const [groupId, setGroupId] = useState<string | null>(null)
  const [studentId, setStudentId] = useState<string | null>(null)
  const [modal, setModal] = useState<Modal>(null)
  const [draftGroup, setDraftGroup] = useState<Group | null>(null)
  const [draftStudent, setDraftStudent] = useState<Student | null>(null)
  const [draftTask, setDraftTask] = useState<StrategyTask | null>(null)
  const [view, setView] = useState<'board' | 'list'>('board')
  const [stageFilter, setStageFilter] = useState<Stage | 'all'>('all')
  const [searchOpen, setSearchOpen] = useState(false)
  const [searchTerm, setSearchTerm] = useState('')
  const [saveError, setSaveError] = useState(false)
  const fileInput = useRef<HTMLInputElement>(null)

  useEffect(() => { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); setSaveError(false) } catch { setSaveError(true) } }, [data])
  const group = data.groups.find(g => g.id === groupId) ?? null
  const student = data.students.find(s => s.id === studentId) ?? null
  const currentTasks = student ? studentTasks(data, student.id) : []
  const activeGroups = data.groups.filter(g => g.status === 'active')
  const hasDemo = data.groups.some(g => g.id.startsWith('demo-'))
  const tasksInActiveGroups = data.tasks.filter(t => {
    const s = data.students.find(student => student.id === t.studentId)
    return s && data.groups.some(g => g.id === s.groupId && g.status === 'active')
  })
  const openPage = (next: Page) => { setPage(next); setGroupId(null); setStudentId(null); setSearchOpen(false) }
  const openGroup = (id: string) => { setPage('strategies'); setGroupId(id); setStudentId(null) }
  const openStudent = (id: string) => { const s = data.students.find(v => v.id === id); if (!s) return; setPage('strategies'); setGroupId(s.groupId); setStudentId(id); setStageFilter('all') }
  const saveGroup = () => { if (!draftGroup?.name.trim()) return; setData(d => ({ ...d, demo: false, groups: d.groups.some(g => g.id === draftGroup.id) ? d.groups.map(g => g.id === draftGroup.id ? draftGroup : g) : [...d.groups, draftGroup] })); setModal(null) }
  const setGroupStatus = (group: Group, status: GroupStatus) => setData(d => ({ ...d, demo: false, groups: d.groups.map(g => g.id === group.id ? { ...g, status, statusBeforeArchive: status === 'archived' ? (g.status === 'archived' ? g.statusBeforeArchive : g.status) : g.statusBeforeArchive, actualEndsAt: status === 'completed' && !g.actualEndsAt ? today() : g.actualEndsAt } : g) }))
  const saveStudent = () => { if (!draftStudent?.name.trim() || !draftStudent.groupId) return; setData(d => ({ ...d, demo: false, students: d.students.some(s => s.id === draftStudent.id) ? d.students.map(s => s.id === draftStudent.id ? draftStudent : s) : [...d.students, draftStudent] })); setModal(null) }
  const patchStudent = (patch: Partial<Student>) => { if (!student) return; setData(d => ({ ...d, demo: false, students: d.students.map(s => s.id === student.id ? { ...s, ...patch } : s) })) }
  const addMeeting = (meeting: Meeting) => setData(d => ({ ...d, demo: false, meetings: [...d.meetings, meeting] }))
  const deleteMeeting = (id: string) => setData(d => ({ ...d, demo: false, meetings: d.meetings.filter(m => m.id !== id) }))
  const saveTask = () => { if (!draftTask?.title.trim()) return; const now = new Date().toISOString(); const task = { ...draftTask, updatedAt: now }; setData(d => ({ ...d, demo: false, tasks: d.tasks.some(t => t.id === task.id) ? d.tasks.map(t => t.id === task.id ? task : t) : [...d.tasks, task], students: d.students.map(s => s.id === task.studentId ? { ...s, strategyUpdatedAt: now } : s) })); setModal(null) }
  const changeTask = (id: string, patch: Partial<StrategyTask>) => setData(d => { const now = new Date().toISOString(); const task = d.tasks.find(t => t.id === id); return { ...d, demo: false, tasks: d.tasks.map(t => t.id === id ? { ...t, ...patch, updatedAt: now } : t), students: d.students.map(s => s.id === task?.studentId ? { ...s, strategyUpdatedAt: now } : s) } })
  const changeStatus = (id: string, status: TaskStatus) => { const max = Math.max(-1, ...data.tasks.filter(t => t.studentId === studentId && t.status === status).map(t => t.order)); changeTask(id, { status, order: max + 1 }) }
  const moveOrder = (task: StrategyTask, delta: number) => { const peers = currentTasks.filter(t => t.status === task.status && (stageFilter === 'all' || t.stage === stageFilter)).sort((a,b) => a.order - b.order); const i = peers.findIndex(t => t.id === task.id); const other = peers[i + delta]; if (!other) return; setData(d => ({ ...d, demo: false, tasks: d.tasks.map(t => t.id === task.id ? { ...t, order: other.order } : t.id === other.id ? { ...t, order: task.order } : t) })) }
  const removeGroup = (g: Group) => { if (data.students.some(s => s.groupId === g.id)) { alert('Сначала переместите или удалите учениц этой группы.'); return } if (!confirm(`Удалить группу «${g.name}»?`)) return; setData(d => ({ ...d, demo: false, groups: d.groups.filter(x => x.id !== g.id) })); setGroupId(null) }
  const removeStudent = (s: Student) => { if (!confirm(`Удалить ученицу «${s.name}», её задачи и историю встреч?`)) return; setData(d => ({ ...d, demo: false, students: d.students.filter(x => x.id !== s.id), tasks: d.tasks.filter(t => t.studentId !== s.id), meetings: d.meetings.filter(m => m.studentId !== s.id) })); setStudentId(null) }
  const removeTask = (t: StrategyTask) => { if (!confirm(`Удалить задачу «${t.title}»?`)) return; setData(d => ({ ...d, demo: false, tasks: d.tasks.filter(x => x.id !== t.id) })); setModal(null) }
  const exportBackup = () => { const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }); const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = `kuratorskaya-backup-${today()}.json`; a.click(); URL.revokeObjectURL(url) }
  const importBackup = async (file?: File) => { if (!file) return; try { const json: unknown = JSON.parse(await file.text()); if (!isAppData(json)) throw new Error(); if (!confirm('Заменить все текущие данные данными из резервной копии?')) return; setData(normalizeData(json)); setGroupId(null); setStudentId(null); setPage('overview'); setModal(null) } catch { alert('Файл не подходит. Нужна резервная копия приложения в формате JSON.') } }

  const attention = useMemo(() => data.students.filter(s => data.groups.some(g => g.id === s.groupId && g.status === 'active')).map(s => {
    const tasks = studentTasks(data, s.id)
    const overdue = tasks.filter(t => t.status !== 'done' && isOverdue(t.dueAt)).length
    const blockers = tasks.filter(t => t.blocker && t.status !== 'done').length
    const stale = Date.now() - new Date(s.strategyUpdatedAt).getTime() > 14 * 86400000
    return { student: s, overdue, blockers, stale }
  }).filter(x => x.overdue || x.blockers || x.stale).sort((a,b) => (b.overdue * 2 + b.blockers + Number(b.stale)) - (a.overdue * 2 + a.blockers + Number(a.stale))), [data])
  const upcoming = tasksInActiveGroups.filter(t => t.status !== 'done' && t.dueAt).sort((a,b) => a.dueAt.localeCompare(b.dueAt)).slice(0, 5)
  const normalizedSearch = searchTerm.trim().toLocaleLowerCase('ru-RU')
  const foundStudents = normalizedSearch ? data.students.filter(s => s.name.toLocaleLowerCase('ru-RU').includes(normalizedSearch)).slice(0, 5) : []
  const foundGroups = normalizedSearch ? data.groups.filter(g => g.name.toLocaleLowerCase('ru-RU').includes(normalizedSearch)).slice(0, 4) : []

  return <div className={`app-shell ${page === 'overview' ? 'overview-shell' : ''}`}>
    <header className="workspace-toolbar">
      <div className="workspace-toolbar-left"><button className="brand-logo" aria-label="Обзор" title="Обзор" onClick={() => openPage('overview')}>к</button><div className="user-pill"><span className="avatar">С</span><span>Софья</span></div></div>
      <nav className="toolbar-nav" aria-label="Основная навигация">{nav.map(({ id, label, icon: Icon }) => <button key={id} className={page === id ? 'active' : ''} aria-label={label} title={label} onClick={() => openPage(id)}><Icon size={17}/></button>)}</nav>
      <div className="workspace-toolbar-right"><label className="group-switch"><select aria-label="Перейти к группе" value={groupId ?? ''} onChange={e => e.target.value ? openGroup(e.target.value) : openPage('strategies')}><option value="">Все группы</option>{data.groups.map(g => <option key={g.id} value={g.id}>{g.name}</option>)}</select><ChevronDown size={12}/></label><button className="toolbar-icon" aria-label="Поиск" title="Поиск" onClick={() => setSearchOpen(v => !v)}><Search size={16}/></button><button className="toolbar-icon" aria-label="Данные и копии" title="Данные и копии" onClick={() => setModal('backup')}><Settings2 size={16}/></button></div>
      {searchOpen && <div className="toolbar-search-panel"><input autoFocus aria-label="Поиск группы или ученицы" placeholder="Группа или ученица" value={searchTerm} onChange={e => setSearchTerm(e.target.value)}/>{normalizedSearch && <div className="toolbar-search-results">{foundStudents.map(s => <button key={s.id} onClick={() => { openStudent(s.id); setSearchOpen(false); setSearchTerm('') }}>{s.name}</button>)}{foundGroups.map(g => <button key={g.id} onClick={() => { openGroup(g.id); setSearchOpen(false); setSearchTerm('') }}>{g.name}</button>)}{!foundStudents.length && !foundGroups.length && <p>Ничего не найдено</p>}</div>}</div>}
    </header>
    <main className={`main ${page === 'overview' ? 'overview-main' : ''}`}>
      {saveError && <div className="save-error">Не удалось сохранить данные в браузере. Экспортируйте резервную копию и проверьте свободное место.</div>}
      {hasDemo && <div className="demo-banner"><span><strong>Демонстрационные данные.</strong> Четыре тестовые группы и профили можно редактировать.</span><button onClick={() => { if (confirm('Удалить все демонстрационные группы, учениц, задачи и встречи? Ваши собственные записи сохранятся.')) { setData(d => ({ ...d, demo: false, groups: d.groups.filter(g => !g.id.startsWith('demo-')), students: d.students.filter(s => !s.id.startsWith('demo-')), tasks: d.tasks.filter(t => !t.id.startsWith('demo-')), meetings: d.meetings.filter(m => !m.id.startsWith('demo-')) })); setGroupId(null); setStudentId(null); setPage('overview') } }}>Убрать пример <ArrowRight size={15}/></button></div>}
      <div className="content">
        {page === 'overview' && <PlanOverview data={data} activeGroups={activeGroups} tasks={tasksInActiveGroups} attention={attention} upcoming={upcoming} onGroup={openGroup} onStudent={openStudent} onTask={id => { const t = data.tasks.find(x => x.id === id); if (t) openStudent(t.studentId) }} onNewGroup={() => { setDraftGroup(newGroup()); setModal('group') }} onStrategies={() => openPage('strategies')} onAnya={() => openPage('anya')}/>}
        {page === 'strategies' && !group && <GroupsPage data={data} onOpen={openGroup} onStudent={openStudent} onNew={() => { setDraftGroup(newGroup()); setModal('group') }} onEdit={g => { setDraftGroup({ ...g }); setModal('group') }} onStatus={setGroupStatus} onDelete={removeGroup}/>}
        {page === 'strategies' && group && !student && <GroupDetailPage data={data} group={group} onBack={() => setGroupId(null)} onStudent={openStudent} onNewStudent={() => { setDraftStudent(newStudent(group.id)); setModal('student') }} onEditGroup={() => { setDraftGroup({ ...group }); setModal('group') }} onStatus={status => setGroupStatus(group,status)}/>} 
        {page === 'strategies' && student && <ProfilePage data={data} student={student} tasks={currentTasks} view={view} setView={setView} stageFilter={stageFilter} setStageFilter={setStageFilter} onBack={() => setStudentId(null)} onEdit={() => { setDraftStudent({ ...student, links: { ...student.links } }); setModal('student') }} onDelete={() => removeStudent(student)} onNewTask={() => { setDraftTask(newTask(student.id, currentTasks.length, student.stage)); setModal('task') }} onEditTask={t => { setDraftTask({ ...t }); setModal('task') }} onStatus={changeStatus} onMove={moveOrder} onPatch={patchStudent} onAddMeeting={addMeeting} onDeleteMeeting={deleteMeeting}/>}
        {page === 'anya' && <AnyaPage data={data} onStudent={openStudent} onEditTask={t => { setDraftTask({ ...t }); setModal('task') }}/>} 
