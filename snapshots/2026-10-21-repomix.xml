import { useState } from 'react'
import { Camera, Trash2 } from 'lucide-react'
import Avatar, { imageFromFile } from './Avatar'
import { GROUP_STATUS, STAGES } from './data'
import type { Group, GroupStatus, Stage, Student } from './types'

function Field({label,children}:{label:string;children:React.ReactNode}){return <label className="field"><span>{label}</span>{children}</label>}

export function GroupForm({draft,setDraft,onSave,onCancel}:{draft:Group;setDraft:(v:Group)=>void;onSave:()=>void;onCancel:()=>void}){
  return <form className="form" onSubmit={e=>{e.preventDefault();onSave()}}><Field label="Название группы"><input required autoFocus value={draft.name} onChange={e=>setDraft({...draft,name:e.target.value})} placeholder="Например, Поток 05"/></Field><div className="form-grid"><Field label="Статус"><select value={draft.status} onChange={e=>{const status=e.target.value as GroupStatus;setDraft({...draft,status,statusBeforeArchive:status==='archived'&&draft.status!=='archived'?draft.status:draft.statusBeforeArchive})}}>{Object.entries(GROUP_STATUS).map(([id,label])=><option key={id} value={id}>{label}</option>)}</select></Field><Field label="Дата начала"><input type="date" value={draft.startsAt} onChange={e=>setDraft({...draft,startsAt:e.target.value})}/></Field><Field label="Планируемое окончание"><input type="date" value={draft.endsAt} onChange={e=>setDraft({...draft,endsAt:e.target.value})}/></Field><Field label="Фактическое завершение"><input type="date" value={draft.actualEndsAt} onChange={e=>setDraft({...draft,actualEndsAt:e.target.value})}/></Field></div><Field label="Заметки куратора"><textarea rows={4} value={draft.notes} onChange={e=>setDraft({...draft,notes:e.target.value})} placeholder="Фокус группы, договорённости, важный контекст"/></Field><div className="form-helper">Плановая дата не меняет статус автоматически. Запуск и завершение подтверждаются вручную.</div><div className="dialog-actions"><button type="button" className="btn secondary" onClick={onCancel}>Отмена</button><button className="btn primary" type="submit">Сохранить группу</button></div></form>
}

export function StudentForm({draft,setDraft,groups,onSave,onCancel}:{draft:Student;setDraft:(v:Student)=>void;groups:Group[];onSave:()=>void;onCancel:()=>void}){
  const [photoError,setPhotoError]=useState('')
  const update=(patch:Partial<Student>)=>setDraft({...draft,...patch})
  const upload=async(file?:File)=>{if(!file)return;try{const photo=await imageFromFile(file);update({photo});setPhotoError('')}catch(e){setPhotoError(e instanceof Error?e.message:'Не удалось загрузить фото.')}}
  return <form className="form" onSubmit={e=>{e.preventDefault();onSave()}}><div className="photo-editor"><Avatar student={draft} size="lg"/><div><strong>Фотография ученицы</strong><p>JPG или PNG до 12 МБ. Изображение уменьшится для локального хранения.</p><div><label className="btn secondary photo-upload"><Camera size={16}/> {draft.photo?'Заменить фото':'Загрузить фото'}<input type="file" accept="image/*" hidden onChange={e=>{void upload(e.target.files?.[0]);e.target.value=''}}/></label>{draft.photo&&<button type="button" className="btn danger" onClick={()=>update({photo:''})}><Trash2 size={15}/> Удалить</button>}</div>{photoError&&<small className="text-red">{photoError}</small>}</div></div>
    <div className="form-section-title">Основная информация</div><div className="form-grid"><Field label="Имя и фамилия"><input required autoFocus value={draft.name} onChange={e=>update({name:e.target.value})} placeholder="Имя и фамилия"/></Field><Field label="Возраст (необязательно)"><input type="number" min="16" max="99" value={draft.age??''} onChange={e=>update({age:e.target.value?Number(e.target.value):null})} placeholder="—"/></Field><Field label="Группа"><select value={draft.groupId} onChange={e=>update({groupId:e.target.value})}>{groups.map(g=><option key={g.id} value={g.id}>{g.name}</option>)}</select></Field><Field label="Дата начала"><input type="date" value={draft.startsAt} onChange={e=>update({startsAt:e.target.value})}/></Field><Field label="Этап обучения"><select value={draft.stage} onChange={e=>update({stage:e.target.value as Stage})}>{STAGES.map(s=><option key={s.id} value={s.id}>{s.number}. {s.label}</option>)}</select></Field><Field label="Профессиональный уровень"><input value={draft.level} onChange={e=>update({level:e.target.value})} placeholder="Junior"/></Field><Field label="Желаемая позиция"><input value={draft.desiredPosition} onChange={e=>update({desiredPosition:e.target.value})} placeholder="Product Designer"/></Field><Field label="Карьерная цель"><input value={draft.careerGoal} onChange={e=>update({careerGoal:e.target.value})} placeholder="Какого результата хочет достичь"/></Field></div>
    <div className="form-section-title">Об ученице</div><div className="form-grid">{([['background','Бэкграунд'],['experience','Опыт работы и проекты'],['strengths','Сильные стороны'],['growthAreas','Зоны роста'],['difficulties','Текущие сложности'],['expectations','Карьерные ожидания'],['personalNotes','Особенности и важные заметки']] as const).map(([key,label])=><Field key={key} label={label}><textarea rows={3} value={draft[key]} onChange={e=>update({[key]:e.target.value})}/></Field>)}</div>
    <div className="form-section-title">Путь во время менторства</div><div className="form-grid"><Field label="Точка А"><textarea rows={3} value={draft.pointA} onChange={e=>update({pointA:e.target.value})} placeholder="Исходная ситуация"/></Field><Field label="Точка Б"><textarea rows={3} value={draft.pointB} onChange={e=>update({pointB:e.target.value})} placeholder="Целевой или достигнутый результат"/></Field></div>
    <div className="form-section-title">Ссылки</div><div className="form-grid">{([['telegram','Telegram'],['resume','Резюме'],['portfolio','Портфолио'],['figma','Figma'],['notion','Notion']] as const).map(([key,label])=><Field key={key} label={label}><input type="url" value={draft.links[key]} onChange={e=>update({links:{...draft.links,[key]:e.target.value}})} placeholder="https://"/></Field>)}</div>
    <div className="dialog-actions"><button type="button" className="btn secondary" onClick={onCancel}>Отмена</button><button className="btn primary" type="submit">Сохранить профиль</button></div>
  </form>
}
