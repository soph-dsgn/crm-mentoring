    { id:'demo-group-3', name:'Весенний поток', startsAt:'2026-05-05', endsAt:'2026-08-05', actualEndsAt:'2026-08-12', status:'completed', statusBeforeArchive:null, notes:'Финальное ревью завершено.', createdAt:now },
    { id:'demo-group-4', name:'Пилотная группа', startsAt:'2026-02-02', endsAt:'2026-05-15', actualEndsAt:'2026-05-20', status:'archived', statusBeforeArchive:'completed', notes:'Пилотный поток, материалы сохранены для ретроспективы.', createdAt:now },
  ]
  const students: Student[] = profileSamples.map((p,i) => ({
    id:`demo-${i+1}`, groupId:groups[Math.floor(i/4)].id, name:p[0], age:23+i%9, photo:'', avatarIndex:i,
