<file path="src/types.ts">
export type Stage = 'start' | 'portfolio' | 'search'
export type TaskStatus = 'backlog' | 'progress' | 'done'
export type GroupStatus = 'backlog' | 'active' | 'completed' | 'archived'
export type Owner = 'Софья' | 'Аня'

export interface Group {
  id: string; name: string; startsAt: string; endsAt: string; actualEndsAt: string;
  status: GroupStatus; statusBeforeArchive: Exclude<GroupStatus, 'archived'> | null;
  notes: string; createdAt: string
}
export interface Student {
  id: string; groupId: string; name: string; age: number | null; photo: string; avatarIndex: number;
  stage: Stage; startsAt: string; level: string; desiredPosition: string; careerGoal: string;
  links: { figma: string; portfolio: string; resume: string; telegram: string; notion: string };
  background: string; experience: string; strengths: string; growthAreas: string;
  difficulties: string; expectations: string; personalNotes: string;
  pointA: string; pointB: string; notes: string; strategyUpdatedAt: string; createdAt: string
}
export interface StrategyTask {
  id: string; studentId: string; title: string; description: string; stage: Stage; status: TaskStatus; owner: Owner;
  dueAt: string; url: string; comments: string; order: number; blocker: boolean; createdAt: string; updatedAt: string
}
export interface Meeting { id: string; studentId: string; date: string; title: string; summary: string; createdAt: string }
export interface AppData { version: 2; groups: Group[]; students: Student[]; tasks: StrategyTask[]; meetings: Meeting[]; demo: boolean; demoRevision?: number }
</file>

<file path="src/vision-ui.css">
:root {
  font-family: 'Manrope Variable', Manrope, sans-serif;
  font-synthesis: none;
  --ui-bg: #f4f5fa;
  --ui-surface: #ffffff;
  --ui-text: #111111;
  --ui-muted: #9a9ca5;
  --ui-line: #eceef2;
  --ui-black: #000000;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --radius-card: 22px;
  --radius-control: 12px;
  color: var(--ui-text);
  background: var(--ui-bg);
}
html, body, #root { width: 100%; min-height: 100dvh; }
html { background: var(--ui-bg); }
body, button, input, select, textarea { font-family: 'Manrope Variable', Manrope, sans-serif; letter-spacing: 0 !important; }
body { background: var(--ui-bg); color: var(--ui-text); font-size: 15px; line-height: 24px; overflow-x: hidden; }
button, a, input, select, textarea { transition: background-color .18s ease, color .18s ease, opacity .18s ease, box-shadow .18s ease; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid #747984 !important; outline-offset: 3px; }
button:hover { transform: none !important; }
svg { flex-shrink: 0; }
.app-shell { display: block; width: 100%; min-height: 100dvh; margin: 0; padding: 0; overflow: clip; background: var(--ui-bg); }
.sidebar { position: relative; top: auto; z-index: 20; width: 100%; height: 76px; padding: 0 48px; border: 0; background: transparent; flex-direction: row; align-items: center; gap: 40px; }
.brand { padding: 0; gap: 10px; font-size: 17px; line-height: 24px; font-weight: 700; white-space: nowrap; letter-spacing: 0; }
.brand-mark { width: 29px; height: 29px; border-radius: 10px; background: #000; transform: none; gap: 3px; grid-template-columns: repeat(2,5px); grid-template-rows: repeat(2,5px); }
.brand-mark span { background: #fff; border-radius: 1px; }
.brand-dot, .lime-dot { color: currentColor; }
.workspace-label { display: none; }
.nav-list { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 4px; min-width: 0; }
.nav-item { width: auto; min-width: 0; height: 36px; padding: 0 10px; gap: 7px; border: 0; border-radius: 10px; color: #777b84; background: transparent; font-size: 12px; line-height: 18px; font-weight: 600; white-space: nowrap; }
.nav-item svg { width: 15px; height: 15px; stroke-width: 1.8; }
.nav-item:hover { background: rgba(255,255,255,.7); color: #111; }
.nav-item.active { background: #fff; color: #111; box-shadow: 0 3px 12px rgba(31,38,60,.035); }
.nav-item.active svg { stroke-width: 2; }
.sidebar-bottom { margin: 0; display: flex; align-items: center; gap: 12px; }
.sidebar-bottom .settings { width: 34px; height: 34px; margin: 0; padding: 0; justify-content: center; font-size: 0; border-radius: 50%; background: #fff; }
.settings svg { width: 16px; height: 16px; }
.profile { display: flex; align-items: center; gap: 8px; padding: 0; border: 0; white-space: nowrap; }
.profile strong { font-size: 11px; line-height: 16px; font-weight: 700; }
.profile small { font-size: 10px; line-height: 14px; color: var(--ui-muted); }
.profile .avatar, .topbar .avatar { width: 32px; height: 32px; color: #fff; background: #111; font-size: 11px; }
.main { width: 100%; min-height: 0; background: transparent; }
.topbar { display: none; }
.content { width: 100%; max-width: none; margin: 0; padding: 28px clamp(40px, 3.34vw, 64px) 56px; }
.demo-banner { margin: 8px clamp(40px, 3.34vw, 64px) 0; padding: 10px 14px; background: rgba(255,255,255,.75); border: 0; border-radius: 10px; font-size: 13px; line-height: 20px; color: #777b84; }
.demo-banner strong { color: #51545d; font-weight: 600; }
.demo-banner button { font-size: 13px; color: #111; font-weight: 600; }
.save-error { margin: 8px clamp(40px, 3.34vw, 64px); }
.eyebrow, .workspace-label, .group-status-text, .task-stage, .node-type { text-transform: none !important; letter-spacing: 0 !important; font-size: 12px !important; font-weight: 500 !important; color: var(--ui-muted) !important; }
.page-heading { align-items: flex-end; margin: 8px 0 28px; gap: 24px; }
.page-heading h1, .profile-identity h1, .next-page h1 { margin: 0; color: #111; font-size: 36px; line-height: 44px; font-weight: 700; letter-spacing: 0 !important; }
.page-heading h1 br { display: none; }
.page-heading h1 .lime-dot, .next-page .lime-dot, .profile-identity .lime-dot { display: none; }
.page-heading p, .profile-identity p { margin: 4px 0 0; color: var(--ui-muted); font-size: 14px; line-height: 22px; }
h2, .section-head h2, .strategy-toolbar h2 { font-size: 24px; line-height: 32px; font-weight: 650; letter-spacing: 0 !important; }
.btn { min-height: 42px; border-radius: 12px; padding: 0 16px; font-size: 14px; line-height: 20px; font-weight: 650; }
.btn.dark, .btn.primary { background: #000; color: #fff; border-color: #000; }
.btn.dark:hover, .btn.primary:hover { background: #303030; color: #fff; }
.btn.secondary { background: #fff; color: #111; border-color: transparent; }
.btn.secondary:hover { background: #f0f1f5; }
.btn.danger { background: #fff; color: #9b3c3c; }
.icon-btn { background: #fff; color: #111; border: 0; }
.surface, .profile-facts, .profile-empty, .group-notes, .next-page, .anya-list, .roster-list { background: #fff; border: 0; border-radius: var(--radius-card); box-shadow: none; }
.surface { padding: 28px; }
.tabs, .profile-tabs { border: 0; gap: 22px; }
.tabs button, .profile-tabs button { padding: 0 0 10px; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; color: #9295a0; font-size: 14px; line-height: 22px; font-weight: 600; }
.tabs button.selected, .profile-tabs button.selected { border-color: #111; background: transparent; color: #111; }
.tabs button span { color: var(--ui-muted); }
.back-link { color: #777b84; font-size: 14px; font-weight: 600; }
.back-link:hover, .text-link:hover { color: #000; }

/* Groups and students use the same card proportions as the reference. */
.editorial-page-head { min-height: 0; padding: 0; }
.editorial-group-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }
.editorial-group-row { display: flex; flex-direction: column; justify-content: space-between; min-height: 250px; overflow: hidden; border: 0; border-radius: var(--radius-card); background: #fff; box-shadow: none; }
.editorial-group-main { position: relative; flex: 1; width: 100%; padding: 28px; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px; border: 0; background: transparent; color: #111; text-align: left; }
.editorial-group-index { display: none; }
.editorial-group-name { flex: 1 1 70%; min-width: 0; display: flex; flex-direction: column; }
.editorial-group-name strong { margin: 5px 0; font-size: 18px; line-height: 26px; font-weight: 650; }
.editorial-group-name small { color: var(--ui-muted); font-size: 13px; line-height: 20px; }
.editorial-group-people { display: flex; align-items: center; }
.editorial-group-people > * + * { margin-left: -7px; }
.editorial-group-momentum { width: 100%; display: flex; flex-direction: column; align-self: flex-end; margin-top: 20px; }
.editorial-group-momentum strong { font-size: 14px; line-height: 22px; font-weight: 600; }
.editorial-group-momentum strong small { font-size: inherit; }
.editorial-group-momentum span { color: var(--ui-muted); font-size: 13px; line-height: 20px; }
.editorial-group-main > svg { position: absolute; right: 24px; bottom: 20px; width: 42px; height: 42px; padding: 11px; border-radius: 50%; background: #000; color: #fff; }
.editorial-group-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 28px 24px; }
.editorial-group-actions button { min-height: 32px; border: 0; background: transparent; color: #6e727b; font-size: 13px; font-weight: 600; }
.editorial-group-actions button:hover { color: #000; }
.editorial-group-actions button.red { color: #a46b6b; }
.roster-head { margin: 34px 0 16px; }
.roster-head h2 { margin: 0; font-size: 24px; line-height: 32px; font-weight: 650; }
.roster-head h2 span { font-size: 13px; color: var(--ui-muted); }
.roster-filters select, .roster-search, .roster-head select { height: 42px; border: 0; border-radius: 10px; background: #fff; color: #111; font-size: 14px; }
.roster-row { padding: 14px 20px; border-color: var(--ui-line); }
.roster-row:hover { background: #fafbfc; }
.roster-name strong { font-size: 15px; }
.roster-name small, .roster-next { font-size: 13px; color: var(--ui-muted); }
.group-detail-heading { margin: 8px 0 28px; }
.group-overview-strip { display: flex; gap: 28px; padding: 14px 0; border: 0; border-top: 1px solid var(--ui-line); border-bottom: 1px solid var(--ui-line); background: transparent; border-radius: 0; }
.group-overview-strip > div { min-width: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: 2px; }
.group-overview-strip small { color: var(--ui-muted); font-size: 13px; line-height: 20px; }
.group-overview-strip strong { color: #111; font-size: 15px; line-height: 22px; font-weight: 600; }
.group-detail-bar { margin: 14px 0 24px; color: #777b84; font-size: 14px; }
.group-detail-bar .btn { min-height: 42px; }
.group-notes { padding: 20px 24px; }
.group-notes small { color: var(--ui-muted); font-size: 13px; }
.group-notes p { font-size: 14px; line-height: 22px; }
.editorial-student-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }
.editorial-student-row { width: 100%; min-width: 0; min-height: 280px; padding: 28px; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 0; border: 0; border-radius: var(--radius-card); background: #fff; text-align: left; color: #111; box-shadow: none; }
.student-card-top { display: flex; align-items: flex-start; justify-content: space-between; width: 100%; }
