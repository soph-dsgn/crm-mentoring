        {page === 'prompts' && <Suspense fallback={<div className="knowledge-loading">Загружаем библиотеку…</div>}><KnowledgePage kind="prompts"/></Suspense>}
        {page === 'textbook' && <Suspense fallback={<div className="knowledge-loading">Загружаем учебник…</div>}><KnowledgePage kind="chapters"/></Suspense>}
      </div>
    </main>
    {modal === 'group' && draftGroup && <Dialog title={data.groups.some(g => g.id === draftGroup.id) ? 'Редактировать группу' : 'Новая группа'} onClose={() => setModal(null)}><GroupForm draft={draftGroup} setDraft={setDraftGroup} onSave={saveGroup} onCancel={() => setModal(null)}/></Dialog>}
    {modal === 'student' && draftStudent && <Dialog title={data.students.some(s => s.id === draftStudent.id) ? 'Профиль ученицы' : 'Новая ученица'} onClose={() => setModal(null)} wide><StudentForm draft={draftStudent} setDraft={setDraftStudent} groups={data.groups} onSave={saveStudent} onCancel={() => setModal(null)}/></Dialog>}
    {modal === 'task' && draftTask && <Dialog title={data.tasks.some(t => t.id === draftTask.id) ? 'Редактировать задачу' : 'Новая задача'} onClose={() => setModal(null)} wide><form onSubmit={e => { e.preventDefault(); saveTask() }} className="form"><Field label="Название задачи"><input required autoFocus value={draftTask.title} onChange={e => setDraftTask({ ...draftTask, title: e.target.value })} placeholder="Что нужно сделать?"/></Field><Field label="Описание"><textarea rows={3} value={draftTask.description} onChange={e => setDraftTask({ ...draftTask, description: e.target.value })} placeholder="Критерии результата, детали задачи"/></Field><div className="form-grid"><Field label="Этап"><select value={draftTask.stage} onChange={e => setDraftTask({ ...draftTask, stage: e.target.value as Stage })}>{STAGES.map(s => <option key={s.id} value={s.id}>{s.number}. {s.label}</option>)}</select></Field><Field label="Статус"><select value={draftTask.status} onChange={e => setDraftTask({ ...draftTask, status: e.target.value as TaskStatus })}>{Object.entries(STATUS).map(([key, label]) => <option key={key} value={key}>{label}</option>)}</select></Field><Field label="Ответственная"><select value={draftTask.owner} onChange={e => setDraftTask({ ...draftTask, owner: e.target.value as StrategyTask['owner'] })}><option>Софья</option><option>Аня</option></select></Field><Field label="Дедлайн"><input type="date" value={draftTask.dueAt} onChange={e => setDraftTask({ ...draftTask, dueAt: e.target.value })}/></Field></div><Field label="Ссылка на материал"><input type="url" value={draftTask.url} onChange={e => setDraftTask({ ...draftTask, url: e.target.value })} placeholder="https://"/></Field><Field label="Комментарии"><textarea rows={3} value={draftTask.comments} onChange={e => setDraftTask({ ...draftTask, comments: e.target.value })} placeholder="Контекст проверки и договорённости"/></Field><label className="check-row"><input type="checkbox" checked={draftTask.blocker} onChange={e => setDraftTask({ ...draftTask, blocker: e.target.checked })}/> Блокирует дальнейшую работу</label><div className="dialog-actions">{data.tasks.some(t => t.id === draftTask.id) && <button type="button" className="btn danger" onClick={() => removeTask(draftTask)}><Trash2 size={16}/> Удалить</button>}<button type="button" className="btn secondary" onClick={() => setModal(null)}>Отмена</button><button className="btn primary" type="submit">Сохранить задачу</button></div></form></Dialog>}
    {modal === 'backup' && <Dialog title="Данные и резервные копии" onClose={() => setModal(null)}><div className="backup-content"><p>Данные этой версии хранятся в текущем браузере. Перед повседневным использованием нужна серверная синхронизация и защита доступа.</p><button className="btn primary full" onClick={exportBackup}><Download size={17}/> Скачать резервную копию</button><button className="btn secondary full" onClick={() => fileInput.current?.click()}><Upload size={17}/> Восстановить из файла</button><input ref={fileInput} type="file" accept="application/json,.json" hidden onChange={e => { importBackup(e.target.files?.[0]); e.target.value = '' }}/></div></Dialog>}
  </div>
}

function Field({ label, children }: { label: string; children: React.ReactNode }) { return <label className="field"><span>{label}</span>{children}</label> }
function Dialog({ title, children, onClose, wide = false }: { title: string; children: React.ReactNode; onClose: () => void; wide?: boolean }) { return <div className="modal-backdrop" onMouseDown={e => { if (e.target === e.currentTarget) onClose() }}><div className={`dialog ${wide ? 'wide' : ''}`} role="dialog" aria-modal="true" aria-label={title}><div className="dialog-head"><h2>{title}</h2><button className="icon-btn" aria-label="Закрыть" onClick={onClose}><X size={20}/></button></div>{children}</div></div> }
function Empty({ title, text, action }: { title: string; text: string; action?: React.ReactNode }) { return <div className="empty"><div className="empty-icon"><Sparkles size={22}/></div><strong>{title}</strong><p>{text}</p>{action}</div> }

function AnyaPage({ data, onStudent, onEditTask }: { data: AppData; onStudent:(id:string)=>void; onEditTask:(t:StrategyTask)=>void }) {
  const [onlyActive, setOnlyActive] = useState(true)
  const tasks = data.tasks.filter(t => t.owner === 'Аня' && (!onlyActive || t.status !== 'done'))
  return <><div className="page-heading"><div><div className="eyebrow">Отдельная очередь</div><h1>Задачи Ани<span className="lime-dot">.</span></h1><p>Все задачи, где нужно участие главного ментора.</p></div></div><div className="tabs"><button className={onlyActive ? 'selected' : ''} onClick={() => setOnlyActive(true)}>Ожидают <span>{data.tasks.filter(t => t.owner === 'Аня' && t.status !== 'done').length}</span></button><button className={!onlyActive ? 'selected' : ''} onClick={() => setOnlyActive(false)}>Все <span>{data.tasks.filter(t => t.owner === 'Аня').length}</span></button></div>{tasks.length ? <div className="anya-list">{tasks.map(t => { const student = data.students.find(s => s.id === t.studentId); const group = data.groups.find(g => g.id === student?.groupId); return <div className="anya-row" key={t.id}><div className="anya-mark"><Sparkles size={19}/></div><div className="anya-main"><button onClick={() => onEditTask(t)}><strong>{t.title}</strong></button><small><button onClick={() => student && onStudent(student.id)}>{student?.name || 'Ученица удалена'}</button> · {group?.name || 'Группа удалена'} · {STATUS[t.status]}</small></div>{t.blocker && <span className="pill blocker">Блокирует</span>}<span className={isOverdue(t.dueAt) && t.status !== 'done' ? 'text-red' : ''}>{t.dueAt ? dateLabel(t.dueAt) : 'Без срока'}</span><button className="icon-btn" title="Редактировать" onClick={() => onEditTask(t)}><ArrowRight size={18}/></button></div> })}</div> : <Empty title="Очередь пуста" text="Назначьте Аню ответственной в задаче стратегии — задача появится здесь."/>}</>
}

function NextPage({ icon: Icon, title, eyebrow, text, action, onAction }: { icon: typeof BookOpen; title:string; eyebrow:string; text:string; action:string; onAction:()=>void }) { return <div className="next-page"><div className="next-icon"><Icon size={32}/></div><div className="eyebrow">{eyebrow}</div><h1>{title}<span className="lime-dot">.</span></h1><p>{text}</p><button className="btn dark" onClick={onAction}>{action} <ArrowRight size={17}/></button></div> }

