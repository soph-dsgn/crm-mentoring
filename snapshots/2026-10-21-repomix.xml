import { useState } from 'react'
import { ArrowLeft, ArrowRight, Plus, RotateCcw, Search, Users } from 'lucide-react'
import Avatar from './Avatar'
import { dateLabel, daysUntil, GROUP_STATUS, groupNextTask, groupProgress, nearestTask, progress, STAGES, studentTasks } from './data'
import type { AppData, Group, GroupStatus, Stage, Student } from './types'

const order:GroupStatus[] = ['active','backlog','completed','archived']
const plural = (n:number, one:string, few:string, many:string) => `${n} ${n%10===1&&n%100!==11?one:n%10>=2&&n%10<=4&&(n%100<12||n%100>14)?few:many}`
const countdown = (group:Group) => { const days=daysUntil(group.status==='backlog'?group.startsAt:group.endsAt); if(days===null)return 'Дата не указана'; if(group.status==='backlog')return days<0?'Плановый старт прошёл — ожидает запуска':days===0?'Плановый старт сегодня':`До старта ${plural(days,'день','дня','дней')}`; if(group.status==='active')return days<0?'Плановый срок завершения прошёл':days===0?'Плановое завершение сегодня':`До завершения ${plural(days,'день','дня','дней')}`; return group.actualEndsAt?`Завершена ${dateLabel(group.actualEndsAt)}`:'Обучение завершено' }

export function GroupsPage({data,onOpen,onStudent,onNew,onEdit,onStatus,onDelete}:{data:AppData;onOpen:(id:string)=>void;onStudent:(id:string)=>void;onNew:()=>void;onEdit:(g:Group)=>void;onStatus:(g:Group,s:GroupStatus)=>void;onDelete:(g:Group)=>void}) {
  const [filter,setFilter]=useState<GroupStatus>('active')
  const [studentGroup,setStudentGroup]=useState('all')
  const [studentStage,setStudentStage]=useState<Stage|'all'>('all')
  const [search,setSearch]=useState('')
  const groups=data.groups.filter(g=>g.status===filter).sort((a,b)=>filter==='backlog'?a.startsAt.localeCompare(b.startsAt):b.startsAt.localeCompare(a.startsAt))
  const students=data.students.filter(s=>(studentGroup==='all'||s.groupId===studentGroup)&&(studentStage==='all'||s.stage===studentStage)&&s.name.toLowerCase().includes(search.toLowerCase()))
  return <><div className="page-heading editorial-page-head"><div><h1>Группы и стратегии</h1></div><button className="btn dark" onClick={onNew}><Plus size={18}/> Новая группа</button></div>
    <div className="tabs lifecycle-tabs">{order.map(status=><button key={status} className={filter===status?'selected':''} onClick={()=>setFilter(status)}>{status==='active'?'Активные':status==='backlog'?'Бэклог':status==='completed'?'Завершённые':'Архив'} <span>{data.groups.filter(g=>g.status===status).length}</span></button>)}</div>
    {groups.length?<div className="editorial-group-list">{groups.map((g,i)=><GroupCard key={g.id} data={data} group={g} index={i} onOpen={()=>onOpen(g.id)} onEdit={()=>onEdit(g)} onStatus={s=>onStatus(g,s)} onDelete={()=>onDelete(g)}/>)}</div>:<div className="profile-empty"><Users size={28}/><strong>{filter==='backlog'?'Пока нет запланированных групп':filter==='archived'?'Архив пуст':filter==='completed'?'Завершённых групп пока нет':'Нет активных групп'}</strong><p>Группы этого статуса появятся здесь.</p><button className="btn primary" onClick={onNew}><Plus size={16}/> Создать группу</button></div>}
    <div className="roster-head"><div><h2>Все ученицы <span>{students.length}</span></h2></div><div className="roster-filters"><label className="roster-search"><Search size={15}/><input aria-label="Поиск ученицы" placeholder="Поиск по имени" value={search} onChange={e=>setSearch(e.target.value)}/></label><select aria-label="Фильтр группы" value={studentGroup} onChange={e=>setStudentGroup(e.target.value)}><option value="all">Все группы</option>{data.groups.map(g=><option key={g.id} value={g.id}>{g.name}</option>)}</select><select aria-label="Фильтр этапа" value={studentStage} onChange={e=>setStudentStage(e.target.value as Stage|'all')}><option value="all">Все этапы</option>{STAGES.map(s=><option key={s.id} value={s.id}>{s.number}. {s.label}</option>)}</select></div></div>
    {students.length?<div className="roster-list">{students.map(s=>{const group=data.groups.find(g=>g.id===s.groupId);const tasks=studentTasks(data,s.id);const next=nearestTask(tasks);return <button className="roster-row" key={s.id} onClick={()=>onStudent(s.id)}><Avatar student={s} size="sm"/><span className="roster-name"><strong>{s.name}</strong><small>{group?.name} · {STAGES.find(st=>st.id===s.stage)?.label}</small></span><span className="roster-next">{next?next.title:'Нет ближайшей задачи'}</span><strong className="roster-progress">{progress(tasks)}%</strong><ArrowRight size={17}/></button>})}</div>:<div className="profile-empty"><strong>Ученицы не найдены</strong><p>Измените фильтры или добавьте ученицу в группу.</p></div>}
  </>
}

function GroupCard({data,group,index,onOpen,onEdit,onStatus,onDelete}:{data:AppData;group:Group;index:number;onOpen:()=>void;onEdit:()=>void;onStatus:(s:GroupStatus)=>void;onDelete:()=>void}) {
  const students=data.students.filter(s=>s.groupId===group.id)
  const next=groupNextTask(data,group)
  const value=groupProgress(data,group)
  return <article className="editorial-group-row"><button className="editorial-group-main" onClick={onOpen}><span className="editorial-group-index">{String(index+1).padStart(2,'0')}</span><span className="editorial-group-name"><span className="group-status-text">{GROUP_STATUS[group.status]} · {countdown(group)}</span><strong>{group.name}</strong><small>{dateLabel(group.startsAt)} — {dateLabel(group.endsAt)} · {plural(students.length,'ученица','ученицы','учениц')}</small></span><span className="editorial-group-people">{students.slice(0,4).map(s=><Avatar key={s.id} student={s} size="sm"/>)}</span><span className="editorial-group-momentum"><strong>{value}<small>%</small></strong><span>{next?next.title:'Следующая задача не назначена'}</span></span><ArrowRight size={22}/></button><div className="editorial-group-actions"><button onClick={onEdit}>Редактировать</button>{group.status==='backlog'&&<button onClick={()=>onStatus('active')}>Запустить</button>}{group.status==='active'&&<button onClick={()=>onStatus('completed')}>Завершить</button>}{group.status==='completed'&&<button onClick={()=>onStatus('archived')}>В архив</button>}{group.status==='archived'&&<button onClick={()=>onStatus(group.statusBeforeArchive||'completed')}><RotateCcw size={13}/> Восстановить</button>}<button className="red" onClick={onDelete}>Удалить</button></div></article>
}

export function GroupDetailPage({data,group,onBack,onStudent,onNewStudent,onEditGroup,onStatus}:{data:AppData;group:Group;onBack:()=>void;onStudent:(id:string)=>void;onNewStudent:()=>void;onEditGroup:()=>void;onStatus:(s:GroupStatus)=>void}) {
  const [stage,setStage]=useState<Stage|'all'>('all')
  const all=data.students.filter(s=>s.groupId===group.id)
  const students=all.filter(s=>stage==='all'||s.stage===stage)
  return <><button className="back-link" onClick={onBack}><ArrowLeft size={16}/> Все группы</button><div className="page-heading group-detail-heading editorial-page-head"><div><div className="eyebrow">{GROUP_STATUS[group.status]} · {dateLabel(group.startsAt)} — {dateLabel(group.endsAt)}</div><h1>{group.name}</h1><p>{plural(all.length,'ученица','ученицы','учениц')} · Прогресс {groupProgress(data,group)}%</p></div><div className="heading-actions"><button className="btn secondary" onClick={onEditGroup}>Редактировать</button><button className="btn dark" onClick={onNewStudent}><Plus size={18}/> Добавить ученицу</button></div></div>
    <div className="roster-head"><div><h2>Ученицы <span>{students.length}</span></h2></div><select aria-label="Фильтр учениц по этапу" value={stage} onChange={e=>setStage(e.target.value as Stage|'all')}><option value="all">Все этапы</option>{STAGES.map(s=><option value={s.id} key={s.id}>{s.number}. {s.label}</option>)}</select></div>
