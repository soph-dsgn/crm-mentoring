{
  "name": "crm-mentoring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src scripts acceptance playwright.config.mjs eslint.config.js --max-warnings 0",
    "build": "tsc -b && vite build",
    "verify": "npm run verify:workflow",
    "verify:release": "playwright test",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:accounts": "node scripts/verify-accounts.mjs",
    "verify:groups-students": "node scripts/verify-groups-students.mjs",
    "verify:strategies": "node scripts/verify-strategies.mjs",
    "verify:meetings-homeworks": "node scripts/verify-meetings-homeworks.mjs",
    "verify:student-workflow": "node scripts/verify-student-workflow.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "verify:knowledge": "node scripts/verify-knowledge.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs && node scripts/verify-auth.mjs && node scripts/verify-accounts.mjs && node scripts/verify-groups-students.mjs && node scripts/verify-strategies.mjs && node scripts/verify-meetings-homeworks.mjs && node scripts/verify-student-workflow.mjs && node scripts/verify-migration.mjs && node scripts/verify-knowledge.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.4.1",
    "@tailwindcss/vite": "^4.1.0",
    "dompurify": "^3.4.17",
    "framer-motion": "^14.5.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0"
  }
}
